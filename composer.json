{
  "name": "rancabali/web-peta-wisata",
  "type": "project",
  "description": "Web Peta Wisata Rancabali",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.0"
  },
  "require-dev": {},
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
